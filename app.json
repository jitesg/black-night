{
  "expo": {
    "name": "InvestSuite",
    "slug": "investsuite-core",
    "version": "1.0.583",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appd2z6dwnk2jnl"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#3B2A18"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appd2z6dwnk2jnl",
      "backgroundColor": "#111827",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansDevanagari-Regular.ttf"
          ]
        }
      ],
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InvestSuite to access your photos for evidence and records.",
          "cameraPermission": "Allow InvestSuite to use the camera to capture photos and documents."
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-cop.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF5",
          "dark": {
            "image": "./assets/splash-cop.png",
            "backgroundColor": "#14201A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B08D57",
          "defaultChannel": "app_alerts_v2",
          "sounds": [
            "./assets/sounds/bell.wav",
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      "@react-native-async-storage/expo-with-async-storage",
      "expo-sharing",
      "expo-file-system",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow InvestSuite to use Face ID for authentication."
        }
      ],
      "./plugins/withHighRefreshRate"
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "appd2z6dwnk2jnl"
  }
}
