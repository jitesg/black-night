{
  "expo": {
    "name": "InvestSuite",
    "slug": "investsuite-core",
    "version": "1.0.583",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appd2z6dwnk2jnl"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appd2z6dwnk2jnl",
      "backgroundColor": "#111827",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansDevanagari-Regular.ttf"
          ]
        }
      ],
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InvestSuite to access your photos for evidence and records.",
          "cameraPermission": "Allow InvestSuite to use the camera to capture photos and documents."
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1E3A5F",
          "defaultChannel": "default"
        }
      ],
      "@react-native-async-storage/expo-with-async-storage",
      "expo-sharing",
      "expo-file-system",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow InvestSuite to use Face ID for authentication."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow InvestSuite to access your microphone.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "appd2z6dwnk2jnl"
  }
}